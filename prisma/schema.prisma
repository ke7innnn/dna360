// DNA 360 — Coaching & Training Module Prisma Schema
// Single Source of Truth for Training Models and Enums

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  CORE
  FULL_BODY
  CARDIO
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  BAND
  CARDIO_MACHINE
  REFORMER
  OTHER
}

enum ProgramGoal {
  FAT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  REHAB
  GENERAL
}

enum ProgramOwner {
  TRAINER
  MEMBER
  GYM
}

enum ProgramVisibility {
  PRIVATE
  ASSIGNED_ONLY
  GYM_LIBRARY
}

enum CoachingMode {
  SELF_COACHED
  TRAINER_LED
}

enum AdaptationPolicy {
  LOCKED
  SWAP_ONLY
  FLEXIBLE
}

enum ScheduleMode {
  FIXED_DAYS
  FLEXIBLE
  SEQUENTIAL
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  EXPIRED
}

enum ExerciseSource {
  PROGRAM
  MEMBER_ADDED
  SWAPPED
}

model Exercise {
  id               String            @id @default(cuid())
  name             String
  primaryMuscle    MuscleGroup
  secondaryMuscles MuscleGroup[]
  equipment        Equipment
  instructions     String?
  demoMediaKey     String?
  isCustom         Boolean           @default(false)
  createdById      String?           // member OR trainer — both can add
  approvedAt       DateTime?         // custom exercises enter a review queue
  mergedIntoId     String?           // dedupe target when a manager merges duplicates
  archivedAt       DateTime?
  programExercises ProgramExercise[]
  sessionExercises SessionExercise[]

  @@unique([name, equipment])
  @@index([primaryMuscle])
  @@index([equipment])
}

model Program {
  id           String            @id @default(cuid())
  name         String
  goal         ProgramGoal
  weeks        Int               @default(4)
  daysPerWeek  Int
  notes        String?
  ownerType    ProgramOwner
  ownerId      String            // trainer id, member id, or gym id
  visibility   ProgramVisibility @default(PRIVATE)
  clonedFromId String?           // provenance when copied out of the gym library
  days         ProgramDay[]
  archivedAt   DateTime?

  @@index([ownerType, ownerId])
  @@index([visibility])
}

model ProgramDay {
  id        String            @id @default(cuid())
  programId String
  weekIndex Int
  dayIndex  Int
  label     String
  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises ProgramExercise[]

  @@unique([programId, weekIndex, dayIndex])
  @@index([programId])
}

model ProgramExercise {
  id           String     @id @default(cuid())
  programDayId String
  exerciseId   String
  order        Int
  sets         Int
  repsMin      Int?
  repsMax      Int?
  targetWeight Float?
  rpe          Float?
  restSeconds  Int?
  tempo        String?
  supersetTag  String?
  coachNote    String?
  isOptional   Boolean    @default(false) // "if you have time" accessory work
  programDay   ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  exercise     Exercise   @relation(fields: [exerciseId], references: [id])

  @@index([programDayId])
  @@index([exerciseId])
}

model MemberProgram {
  id               String                  @id @default(cuid())
  memberId         String
  trainerId        String?                 // NULL for self-coached — this is the pivot
  coachingMode     CoachingMode
  sourceProgramId  String?
  currentVersion   Int                     @default(1)
  snapshot         Json                    // frozen programme at current version
  adaptationPolicy AdaptationPolicy        @default(FLEXIBLE)
  scheduleMode     ScheduleMode            @default(FLEXIBLE)
  scheduleDays     Int[]                   // used only when scheduleMode = FIXED_DAYS
  sessionsPerWeek  Int?                    // used when FLEXIBLE
  startDate        DateTime
  endDate          DateTime?
  status           String                  @default("ACTIVE")
  revisions        MemberProgramRevision[]
  sessions         WorkoutSession[]

  @@index([memberId, status])
  @@index([trainerId, status])
}

model MemberProgramRevision {
  id              String        @id @default(cuid())
  memberProgramId String
  version         Int
  snapshot        Json
  changedById     String
  changedByRole   String        // MEMBER | TRAINER | MANAGER
  changeNote      String?
  createdAt       DateTime      @default(now())
  memberProgram   MemberProgram @relation(fields: [memberProgramId], references: [id], onDelete: Cascade)

  @@unique([memberProgramId, version])
  @@index([memberProgramId])
}

model WorkoutSession {
  id              String            @id @default(cuid())
  memberId        String            // always set — freestyle sessions have no programme
  memberProgramId String?           // NULL for freestyle
  programVersion  Int?              // which revision this session was run under
  weekIndex       Int?
  dayIndex        Int?
  title           String?           // freestyle label: "Back and biceps"
  scheduledDate   DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  status          SessionStatus     @default(SCHEDULED)
  memberFeedback  String?
  perceivedEffort Int?
  ptSessionId     String?           // set only if this consumed a paid PT session
  memberProgram   MemberProgram?    @relation(fields: [memberProgramId], references: [id], onDelete: SetNull)
  exercises       SessionExercise[]

  @@index([memberId, scheduledDate])
  @@index([memberProgramId, scheduledDate])
}

model SessionExercise {
  id            String          @id @default(cuid())
  sessionId     String
  exerciseId    String
  order         Int
  prescribed    Json?           // frozen prescription; NULL for freestyle or member-added
  source        ExerciseSource  @default(PROGRAM)
  swappedFromId String?
  skipped       Boolean         @default(false)
  note          String?
  session       WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise      Exercise        @relation(fields: [exerciseId], references: [id])
  setLogs       SetLog[]

  @@index([sessionId])
  @@index([exerciseId])
}

model SetLog {
  id                String          @id @default(cuid())
  sessionExerciseId String
  setIndex          Int
  reps              Int?
  weightKg          Float?
  durationSeconds   Int?            // cardio and timed holds
  distanceMetres    Float?          // cardio
  rpe               Float?
  isWarmup          Boolean         @default(false)
  completedAt       DateTime        @default(now())
  clientLogId       String          @unique // idempotency key for offline sync
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId])
  @@index([clientLogId])
}

model BodyMetric {
  id           String   @id @default(cuid())
  memberId     String
  recordedAt   DateTime
  weightKg     Float?
  bodyFatPct   Float?
  measurements Json?
  photoKeys    String[]
  recordedById String

  @@index([memberId, recordedAt])
}

model CoachNote {
  id        String    @id @default(cuid())
  authorId  String
  memberId  String
  sessionId String?
  body      String
  mediaKey  String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([memberId, createdAt])
  @@index([authorId])
}

model FormCheck {
  id         String    @id @default(cuid())
  memberId   String
  trainerId  String
  exerciseId String?
  videoKey   String
  memberNote String?
  reviewedAt DateTime?
  reviewBody String?
  createdAt  DateTime  @default(now())

  @@index([memberId, createdAt])
  @@index([trainerId, reviewedAt])
}

model GymTrainingSettings {
  id                      String  @id @default(cuid())
  gymId                   String  @unique
  weightUnit              String  @default("kg")
  defaultRestSeconds      Int     @default(90)
  membersCanBuildPrograms Boolean @default(true)
  gymLibraryEnabled       Boolean @default(true)
  freestyleLoggingEnabled Boolean @default(true)
  ptUpsellPromptsEnabled  Boolean @default(true)
  mediaRetentionDays      Int     @default(180)
  customExerciseApproval  Boolean @default(true)
}

// ─── DNA 360 Core Central Database Models ───

model Member {
  id                         String         @id
  memberCode                 String         @unique
  firstName                  String
  lastName                   String
  name                       String
  email                      String?
  phone                      String
  gender                     String         @default("other")
  dob                        String?
  avatarUrl                  String?
  joinedDate                 String
  status                     String         @default("active") // active, expiring_soon, grace_period, inactive, blacklisted
  attendanceStreak           Int            @default(0)
  totalCheckIns              Int            @default(0)
  lastVisitAt                DateTime?
  blacklisted                Boolean        @default(false)
  blacklistReason            String?
  complimentary              Boolean        @default(false)
  specialInclusions          String?
  referredBy                 String?
  referralCode               String?
  lifetimeValue              BigInt         @default(0) // paise
  mediaConsent               Boolean?       @default(true)
  adjustmentCreditsRemaining Int            @default(0)
  assignedTrainerId          String?
  assignedTrainerName        String?
  memberships                Membership[]
  bookings                   ClassBooking[]
  ptSessionLogs              PTSessionLog[]
  invoices                   Invoice[]
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([assignedTrainerId])
}

model Membership {
  id                 String    @id
  memberId           String
  productId          String
  productName        String
  category           String    @default("gym_membership")
  enrolmentDate      String
  activationDate     String?
  expiryDate         String?
  amountPaid         BigInt    @default(0) // paise
  discountAmount     BigInt    @default(0)
  taxRate            Float     @default(0.05)
  status             String    @default("active") // pending_activation, active, expired, void
  invoiceId          String?
  invoiceNumber      String?
  sessionsTotal      Int?
  sessionsConsumed   Int?      @default(0)
  sessionsRemaining  Int?
  member             Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([memberId, status])
  @@index([expiryDate])
}

model ClassSession {
  id                  String         @id
  title               String
  category            String
  instructorId        String
  instructorName      String
  studioId            String
  studioName          String
  date                String         // YYYY-MM-DD local
  dayOfWeek           Int            // 0=Sun..6=Sat
  startTime           String         // HH:MM
  endTime             String         // HH:MM
  durationMinutes     Int
  capacity            Int            @default(20)
  bookedCount         Int            @default(0)
  waitlistCount       Int            @default(0)
  maxWaitlist         Int            @default(5)
  intensity           String         @default("High")
  description         String?
  status              String         @default("scheduled") // scheduled, full, cancelled, completed
  pilatesDayGroup     String?        // A, B
  recurringScheduleId String?
  bookings            ClassBooking[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([date, status])
  @@index([instructorId, date])
  @@index([studioId, date])
}

model ClassBooking {
  id                   String       @id
  sessionId            String
  memberId             String
  memberName           String
  memberPhone          String
  memberCode           String
  status               String       @default("confirmed") // confirmed, waitlisted, cancelled, attended, no_show
  waitlistPosition     Int?
  bookedAt             DateTime     @default(now())
  cancelledAt          DateTime?
  checkedInAt          DateTime?
  adjustmentCreditUsed Boolean      @default(false)
  session              ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member               Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([memberId, status])
}

model PTSessionLog {
  id              String   @id
  memberId        String
  memberName      String
  trainerId       String
  trainerName     String
  date            String   // YYYY-MM-DD
  durationMinutes Int      @default(60)
  workoutFocus    String
  rating          Int      @default(5)
  clientFeedback  String?
  status          String   @default("completed") // completed, cancelled, no_show
  ptTier          String?  @default("premium")
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([memberId, date])
  @@index([trainerId, date])
}

model Invoice {
  id               String        @id
  invoiceNumber    String        @unique
  memberId         String
  memberName       String
  memberPhone      String
  memberEmail      String?
  status           String        @default("pending") // pending, paid, partially_paid, void
  subtotalMinor    BigInt        @default(0)
  taxableMinor     BigInt        @default(0)
  cgstMinor        BigInt        @default(0)
  sgstMinor        BigInt        @default(0)
  grandTotalMinor  BigInt        @default(0)
  paidAmountMinor  BigInt        @default(0)
  dueAmountMinor   BigInt        @default(0)
  issueDate        String
  dueDate          String
  salesRepName     String?
  notes            String?
  member           Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payments         Payment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([memberId, status])
  @@index([status])
}

model Payment {
  id             String   @id
  invoiceId      String
  mode           String   @default("Online") // UPI, Card, Razorpay Live, Cash, Net Banking
  amountMinor    BigInt
  transactionRef String?
  recordedAt     DateTime @default(now())
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([transactionRef])
}

model RazorpayOrderRecord {
  orderId             String    @id
  invoiceId           String
  memberId            String
  expectedAmountMinor BigInt
  status              String    @default("created") // created, paid, failed
  paymentId           String?
  planId              String?
  planTitle           String?
  createdAt           DateTime  @default(now())
  verifiedAt          DateTime?

  @@index([memberId])
  @@index([invoiceId])
}

model auth_sessions {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token_hash           String    @unique
  user_id              String
  user_type            String
  role_slug            String
  must_change_password Boolean   @default(false)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  last_active_at       DateTime  @default(now()) @db.Timestamptz(6)
  expires_at           DateTime  @db.Timestamptz(6)
  revoked_at           DateTime? @db.Timestamptz(6)
  ip                   String?
  user_agent           String?

  @@index([token_hash], map: "idx_auth_sessions_token")
  @@index([user_id], map: "idx_auth_sessions_user")
}

model login_attempts {
  identifier       String    @id
  attempts         Int       @default(0)
  first_attempt_at DateTime  @default(now()) @db.Timestamptz(6)
  locked_until     DateTime? @db.Timestamptz(6)
}

model rate_limit_events {
  id          BigInt   @id @default(autoincrement())
  bucket_key  String
  occurred_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([bucket_key, occurred_at], map: "idx_rate_limit_bucket")
}


